{
  "name": "twinguild-discord-bot",
  "version": "2.0.0",
  "description": "Advanced Discord logging and monitoring bot with web admin panel",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "npm run build && esbuild dist/index.js --bundle --platform=node --target=node18 --outfile=build/bot.js --minify --external:@prisma/client --external:pg-native",
    "build:exe": "npm run build:bundle && pkg build/bot.js --targets node18-linux-x64,node18-win-x64,node18-macos-x64 --output dist/bin/discord-bot",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node build/bot.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:migrate:create": "node-pg-migrate create",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "logging",
    "monitoring",
    "typescript"
  ],
  "author": "TwinGuild",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "axios": "^1.6.7",
    "pg": "^8.11.3",
    "ioredis": "^5.3.2",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.4",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4",
    "lru-cache": "^10.2.0",
    "express-rate-limit": "^7.1.5",
    "cookie-parser": "^1.4.6",
    "compression": "^1.7.4",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/compression": "^1.7.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1",
    "esbuild": "^0.20.1",
    "pkg": "^5.8.1",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "node-pg-migrate": "^6.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
