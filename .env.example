# ===========================================
# DISCORD BOT CONFIGURATION
# ===========================================

# Bot Token (REQUIRED)
# Get this from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ===========================================
# DATABASE CONFIGURATION (Optional for v2.0)
# ===========================================

# PostgreSQL Connection
# DATABASE_URL=postgresql://discord_bot:password@localhost:5432/discord_bot
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Redis Connection (for caching)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ===========================================
# WEB ADMIN PANEL (Optional - Future Feature)
# ===========================================

# WEB_PORT=3000
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me
# SESSION_SECRET=generate_a_secure_random_string
# JWT_SECRET=generate_another_secure_random_string

# ===========================================
# STORAGE CONFIGURATION
# ===========================================

# Storage provider: 'local', 's3', 'gcs', 'azure'
STORAGE_PROVIDER=local

# Local storage path
LOCAL_STORAGE_PATH=./stored_files

# S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=discord-attachments

# ===========================================
# LOGGING
# ===========================================

# Log level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# Log file path
LOG_FILE_PATH=./logs

# ===========================================
# ENVIRONMENT
# ===========================================

NODE_ENV=production
TZ=UTC
